{
  "schemaVersion": 1,
  "id": "voicechat_e2ee",
  "version": "${mod_version}",
  "name": "Voice Chat E2EE",
  "description": "Verschluesselt Simple Voice Chat mit einem gemeinsamen Key. Nur Spieler mit demselben Key koennen sich hoeren.",
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "voicechate2ee.VoiceChatE2EEClient"
    ]
  },
  "mixins": [
    "voicechat_e2ee.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_dependency}",
    "java": ">=${java_version}",
    "voicechat": ">=2.6.24",
    "fabric-command-api-v2": "*"
  }
}
